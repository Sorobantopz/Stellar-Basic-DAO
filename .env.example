# ── Stellar Basic DAO — Platform API (root src/) ──────────────────────────
# Copy to .env and adjust per environment. All variables are optional;
# the defaults below apply when the variable is unset.

# HTTP port the API listens on.
PORT=3000

# Comma-separated list of origins allowed to call the API cross-origin.
# When unset, any origin is reflected (permissive local-dev default).
# Example: https://app.rustacademy.to,https://admin.rustacademy.to
CORS_ORIGINS=

# Per-IP rate limiting for /api routes. Set RATE_LIMIT_ENABLED=false to
# disable entirely. Under NODE_ENV=test the limiter is always off.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120

# Honor X-Forwarded-For when deriving client IPs for rate limiting.
# Only enable when the app sits behind exactly one trusted reverse proxy.
TRUST_PROXY=false

# Runtime environment: development | test | production
NODE_ENV=development
